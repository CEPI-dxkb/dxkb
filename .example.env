# BV-BRC identity endpoints (server-only)
USER_URL=
USER_AUTH_URL=
USER_VERIFICATION_URL=
USER_REGISTER_URL=
USER_PASSWORD_RESET_URL=
DEFAULT_REALM=bvbrc
# Required. This deployment's own public origin, declared to the shared BV-BRC
# services, so it differs per tier:
#   production  APP_BASE_URL=https://dxkb.org
#   dev         APP_BASE_URL=https://dev.dxkb.org
#   test        APP_BASE_URL=<the test site's origin>
#   local       APP_BASE_URL=http://localhost:3019
# It is sent as:
# - registration_site_url on sign-up. The user service maps exactly
#   https://dxkb.org to the `dxkb` site; every other origin, www.dxkb.org
#   included, is recorded as `unknown` alongside the URL itself.
# - base_url on every job. The AppService matches it exactly against its
#   per-site container table and exports it to the job as P3_BASE_URL, which
#   apps use for links in job reports.
# Sign-up and job submission fail if it is unset or not an absolute http(s) URL.
# Do not put it in .env.development/.env.production: Next picks those by
# NODE_ENV, which is `production` for any `next build`, so they cannot tell the
# dev, test and production deployments apart. Set it in each deployment's own
# environment.
APP_BASE_URL=

SERVICES_API_URL=
WORKSPACE_API_URL=
NEXT_PUBLIC_DATA_API=
APP_SERVICE_URL=
MINHASH_SERVICE_URL=
# Trusted origin for server-side calls to this Next.js app (for example, http://127.0.0.1:3010)
INTERNAL_API_ORIGIN=

DATA_SERVICE_URL=
SRA_VALIDATION_URL=

BVBRC_WEBSITE_API_URL=
PHYLO_MANIFEST_URL=https://www.bv-brc.org/api/content/phyloxml_trees/manifest.json
# Production should normally use an absolute path to the mounted dataset directory.
NEXTSTRAIN_DATASET_DIR=./data/auspice-datasets

WORKSPACE_GUIDE_URL=

# Shock upload allowed origins (comma-separated node URLs, e.g. https://shock.mg-rast.org)
SHOCK_ORIGINS=

# Contact form email delivery (used by /api/contact).
# All optional — defaults mirror BV-BRC, which sends via the deployment server's
# local mail relay (localhost:25, no auth). Override only if using a remote SMTP.
# Port 465 uses implicit TLS; other ports use STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=25
# SMTP credentials — leave blank for an unauthenticated local relay.
SMTP_USER=
SMTP_PASSWORD=
# Address that receives contact form submissions (default: help@dxkb.org).
CONTACT_EMAIL_TO=
# From address for outgoing contact emails (default: DXKB <do-not-reply@dxkb.org>).
CONTACT_EMAIL_FROM=
