{
  "name": "react-dxkb",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack -p 3019",
    "build:auspice": "node scripts/build-auspice.mjs",
    "check:nextstrain-datasets": "tsx scripts/check-nextstrain-datasets.ts",
    "prebuild": "pnpm build:auspice",
    "build": "next build",
    "build-pm2": "pnpm build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:codegen": "playwright codegen http://127.0.0.1:3020",
    "e2e:report": "playwright show-report .misc/playwright-report",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:record": "tsx e2e/scripts/record-har.ts",
    "a11y": "playwright test --config playwright.a11y.config.ts --project=a11y-chromium",
    "a11y:routes": "playwright test --config playwright.a11y.config.ts --project=a11y-chromium tests/a11y/routes-sweep.spec.ts",
    "a11y:deep": "playwright test --config playwright.a11y.config.ts --project=a11y-chromium tests/a11y/deep-tier.spec.ts",
    "a11y:keyboard": "playwright test --config playwright.a11y.config.ts --project=a11y-chromium tests/a11y/keyboard.spec.ts",
    "a11y:primitives": "vitest run --config vitest.a11y.config.mts",
    "a11y:motion": "playwright test --config playwright.a11y.config.ts --project=a11y-chromium tests/a11y/reduced-motion.spec.ts",
    "a11y:meta": "playwright test --config playwright.a11y.meta.config.ts",
    "a11y:tripwire": "playwright test --config playwright.a11y.config.ts --project=a11y-webkit-tripwire --project=a11y-firefox-tripwire",
    "a11y:mobile": "playwright test --config playwright.a11y.config.ts --project=a11y-mobile-chromium tests/a11y/routes-sweep.spec.ts",
    "a11y:report": "playwright show-report .misc/a11y-report/html",
    "a11y:baseline:update": "pnpm a11y:routes && tsx e2e/scripts/update-baseline.ts"
  },
  "dependencies": {
