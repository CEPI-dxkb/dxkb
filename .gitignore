# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/dist/
/public/nextstrain-viewer.html
/public/auspice-favicon.png
/public/.auspice-build-hash
/.auspice-build/
/data/auspice-datasets/*
!/data/auspice-datasets/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.e2e.test
*.conf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude
.claude/settings.local.json
.claude/scheduled_tasks.lock
/plans/
/reports/
.superpowers
/docs/superpowers

# Playwright MCP
.playwright-mcp

# Playwright e2e
/playwright/.cache/
/e2e/.auth/
# /e2e/__snapshots__ is NOT ignored — baselines must be committed for visual regression to work.
#
# Every folder the Playwright and a11y configs write — outputDir, JSON reports,
# HTML reports, scan records — is configured under /.misc, which is ignored
# wholesale at the bottom of this file. The one Playwright output no config
# names is `blob-report/`: nothing here sets `--reporter=blob`, so it is never
# produced. If you enable it, set PLAYWRIGHT_BLOB_OUTPUT_DIR under /.misc too
# rather than re-adding a root ignore for it.

# Auspice / Nextstrain viewer build output
/public/dist/
/public/nextstrain-viewer.html
/public/auspice-favicon.png
/public/.auspice-build-hash

# MCP debug screenshots (never committed)
/.screenshots/

# graphify
graphify-out

# misc
/.misc