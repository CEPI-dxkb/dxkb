# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/dist/
/public/nextstrain-viewer.html
/public/auspice-favicon.png
/public/.auspice-build-hash
/.auspice-build/
/data/auspice-datasets/*
!/data/auspice-datasets/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.e2e.test
*.conf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude
.claude/settings.local.json
.claude/scheduled_tasks.lock
/plans/
/reports/
.superpowers
/docs/superpowers

# Playwright MCP
.playwright-mcp

# Playwright e2e
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/
# /e2e/__snapshots__ is NOT ignored — baselines must be committed for visual regression to work.
# Playwright + a11y output (outputDir, JSON reports, HTML reports, scan records)
# all live under /.misc, which is ignored wholesale at the bottom of this file.

# Auspice / Nextstrain viewer build output
/public/dist/
/public/nextstrain-viewer.html
/public/auspice-favicon.png
/public/.auspice-build-hash

# MCP debug screenshots (never committed)
/.screenshots/

# graphify
graphify-out

# misc
/.misc